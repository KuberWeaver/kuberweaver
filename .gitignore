# Downloaded brick roles are installed from their pinned requirements.
plugins/*/roles/
# The Cloudflare connector role is first-party source, not a download.
!plugins/cloudflare-tunnel/roles/
# Brick collections are installed from their pinned requirements, never committed
plugins/*/collections/

# Private notes and prompts, never published
docs/prompt/

# Local credentials and infrastructure state, never publish
*.pem
*.key
id_rsa
id_ed25519
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
*.sqlite
*.sqlite3
*.db
coverage/
.coverage
htmlcov/

# Generated document review images, final PDFs remain publishable
docs/note-cadrage/apercu-page-*.png
docs/note-cadrage/cahier-apercu-*.png

*.egg-info/
build/
dist/

# kw autopilot runtime state
ops/autopilot-kw/.lock
ops/autopilot-kw/runner.log
ops/autopilot-kw/STOP


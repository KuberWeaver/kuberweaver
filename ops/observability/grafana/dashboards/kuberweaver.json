{
  "uid": "kuberweaver-local",
  "title": "KuberWeaver \u2014 local application evidence",
  "description": "Aggregate local evidence; missing series are never mapped to success.",
  "tags": [
    "kuberweaver",
    "local-app"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "App instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "kuberweaver-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"kuberweaver\",service=\"kuberweaver\"}, instance)",
          "refId": "instance"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Evidence boundaries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Local app monitoring only.** No data means unknown, not healthy. Scrape success is not worker or upstream success. Provider configuration is not a live probe. Health reads never refresh inventory or resolve secrets. Duration gauges cover valid persisted terminal jobs and include approval waiting; they are not execution latency or an SLO. No Alertmanager delivery is provisioned."
      }
    },
    {
      "id": 2,
      "title": "Scrape reachable (not application health)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kuberweaver-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"kuberweaver\",service=\"kuberweaver\",instance=~\"$instance\"}",
          "legendFormat": "{{status}}{{kind}} {{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data / unknown",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },

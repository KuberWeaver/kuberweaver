[Unit]
Description=KuberWeaver local infrastructure prototype
After=network-online.target kuberweaver-bao-tunnel.service
Wants=kuberweaver-bao-tunnel.service

[Service]
Type=simple
WorkingDirectory=/home/ubu/Desktop/infra-platform-lab/Prototype/kuberweaver
Environment=PYTHONPATH=/home/ubu/Desktop/infra-platform-lab/Prototype/kuberweaver/backend
Environment=TMPDIR=/home/ubu/.hermes/cache/scratch
ExecStart=/home/ubu/Desktop/infra-platform-lab/Prototype/kuberweaver/.venv/bin/uvicorn kuberweaver.app:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=3
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

[Unit]
Description=KuberWeaver local infrastructure prototype
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubu/Desktop/infra-platform-lab/Prototype/kuberweaver
Environment=TMPDIR=/home/ubu/.hermes/cache/scratch
Environment=KUBERWEAVER_DATABASE_URL_FILE=/home/ubu/Desktop/infra-platform-lab/Prototype/kuberweaver/data/config/database-url
ExecStart=/home/ubu/Desktop/infra-platform-lab/Prototype/kuberweaver/.venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=3
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
